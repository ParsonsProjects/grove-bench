# Only install package versions that have been public for at least 7 days,
# so a hijacked release is usually spotted and pulled before it reaches us.
# To let one package through early (an urgent security fix, say), add:
#   min-release-age-exclude[]=<package-name>
# npm checks this only when it picks a version, not for versions already in
# package-lock.json; scripts/check-release-age.mjs checks lockfile changes.
min-release-age=7

# Stop the install if a dependency has an install script (preinstall,
# install, postinstall) that "allowScripts" in package.json doesn't name.
# Those scripts run as soon as the package installs, so a bad release runs
# its code before anything imports it. Without this, npm 11 runs them and
# only warns. When a new package with one fails the install, read its
# script, then:
#   npm install <name> --ignore-scripts
#   npm install-scripts approve <name>   (or deny, if it works without it)
#   npm rebuild <name>                   (runs the approved script)
strict-allow-scripts=true
# Approve by package name, not name@version, so bumping an approved package
# doesn't stop the install again. A new version still waits min-release-age.
allow-scripts-pin=false

# Only install packages from the registry: refuse dependencies that point to
# a git repo, a tarball URL, a tarball file or a folder. Nothing uses them.
allow-git=none
allow-remote=none
allow-file=none
allow-directory=none

# npm skips settings it doesn't know: min-release-age needs 11.10.0,
# allow-remote, allow-file and allow-directory 11.14.0, strict-allow-scripts
# 11.16.0 and min-release-age-exclude 11.17.0. engine-strict turns the
# "engines.npm" range in package.json (>=11.19.0) into an error instead of a
# warning, so an older npm refuses to install rather than skipping the checks.
engine-strict=true
